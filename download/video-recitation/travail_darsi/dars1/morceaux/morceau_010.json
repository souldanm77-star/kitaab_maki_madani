 "segments": [
  {
   "debut": 4800.0,
   "fin": 4803.02,
   "langue": "ar",
   "texte": "وكيف ترى أن يحرن بأن نوحة أنت أهين؟"
  },
  {
   "debut": 4803.02,
   "fin": 4806.1,
   "langue": "ar",
   "texte": "لبيه صدق مركز فكسارت وولبيه سديت سورضان"
  },
  {
   "debut": 4806.1,
   "fin": 4807.72,
   "langue": "ar",
   "texte": "مكيم تنزله"
  },
  {
   "debut": 4807.72,
   "fin": 4808.82,
   "langue": "ar",
   "texte": "أم كويه"
  },
  {
   "debut": 4808.82,
   "fin": 4810.72,
   "langue": "ar",
   "texte": "وكيف ترى أن نوحة وارتها؟"
  },
  {
   "debut": 4810.72,
   "fin": 4812.32,
   "langue": "ar",
   "texte": "الله سبحانه وتعالى على على"
  },
  {
   "debut": 4813.14,
   "fin": 4814.88,
   "langue": "ar",
   "texte": "سبحانك اللهم بحمدك"
  },
  {
   "debut": 4814.88,
   "fin": 4815.96,
   "langue": "ar",
   "texte": "أشهدوا الله إلهي"
  },
  {
   "debut": 4815.96,
   "fin": 4817.52,
   "langue": "ar",
   "texte": "لن تستفره تبيرك"
  },
  {
   "debut": 4817.52,
   "fin": 4818.74,
   "langue": "ar",
   "texte": "صلى الله عليه وسلم"
  }
 ]
