 "segments": [
  {
   "debut": 5280.0,
   "fin": 5282.38,
   "langue": "ar",
   "texte": "بلا يسمعنا تعاوبة قوبراكه يو"
  },
  {
   "debut": 5283.0,
   "fin": 5284.9,
   "langue": "ar",
   "texte": "بلا يساس الوغبري الناق"
  },
  {
   "debut": 5284.9,
   "fin": 5288.32,
   "langue": "ar",
   "texte": "سيدو كلاغ واحي ممهد علينه"
  },
  {
   "debut": 5288.7,
   "fin": 5291.86,
   "langue": "ar",
   "texte": "ما عملك مسايف تجمع الهدى"
  },
  {
   "debut": 5291.86,
   "fin": 5294.26,
   "langue": "ar",
   "texte": "لكن شاية خضر"
  },
  {
   "debut": 5294.26,
   "fin": 5297.26,
   "langue": "ar",
   "texte": "ومركست ومسايف الوه بعضه"
  },
  {
   "debut": 5297.26,
   "fin": 5299.86,
   "langue": "ar",
   "texte": "اندروس لغا أطريه عشر وليدي شاديو"
  },
  {
   "debut": 5299.86,
   "fin": 5303.28,
   "langue": "ar",
   "texte": "سيادي الدون وناكسن نوسر ويها"
  },
  {
   "debut": 5303.68,
   "fin": 5305.5,
   "langue": "ar",
   "texte": "وعلي زاكم بزاكم الله وخيرا"
  },
  {
   "debut": 5305.5,
   "fin": 5314.92,
   "langue": "ar",
   "texte": "سلوك الوحيد ومهدنا قينا المعصص تلكرم للدعوة التلمية أو نهو جيب اليوم شيخ خالق"
  },
  {
   "debut": 5314.92,
   "fin": 5319.5,
   "langue": "ar",
   "texte": "وحلنا هي ديكنا الليل كا أول مريو ديك يا خيكة"
  },
  {
   "debut": 5320.2,
   "fin": 5326.76,
   "langue": "ar",
   "texte": "فصد قالي ويهي مرحبا شيخ واركنو ويهي بدون حضره جلوات عمامه"
  },
  {
   "debut": 5326.76,
   "fin": 5333.24,
   "langue": "ar",
   "texte": "أرضي دي تشعل الي شيخ خوح ادناته دروس ديسة عين برطان"
  },
  {
   "debut": 5333.24,
   "fin": 5336.16,
   "langue": "ar",
   "texte": "كانت نقدم اعيان الله وحبادك صديقية."
  },
  {
   "debut": 5337.52,
   "fin": 5339.6,
   "langue": "ar",
   "texte": "بل يصحف جنب الشيخ وخصوطة."
  },
  {
   "debut": 5342.2,
   "fin": 5349.14,
   "langue": "ar",
   "texte": "من ذلك خلال اليوم هو الاجتماعية."
  },
  {
   "debut": 5349.48,
   "fin": 5351.1,
   "langue": "ar",
   "texte": "ولم تأكل هذه الدقرى."
  },
  {
   "debut": 5351.7,
   "fin": 5353.2,
   "langue": "ar",
   "texte": "ورغبت لتحسين على المساعدة."
  },
  {
   "debut": 5353.2,
   "fin": 5354.56,
   "langue": "ar",
   "texte": "ميشتو ميشتو مشهر ميشتو ماهلا غير يواجه كومبون"
  },
  {
   "debut": 5354.56,
   "fin": 5357.7,
   "langue": "ar",
   "texte": "با ليرو اي فصد بل هايستان حطي فطا"
  },
  {
   "debut": 5357.7,
   "fin": 5360.1,
   "langue": "ar",
   "texte": "فصد اس وفصد عمرجة"
  },
  {
   "debut": 5360.1,
   "fin": 5362.24,
   "langue": "ar",
   "texte": "فصد افصد او خطي قا"
  },
  {
   "debut": 5363.0,
   "fin": 5364.72,
   "langue": "ar",
   "texte": "شالسة وضب في عياد هايستان"
  },
  {
   "debut": 5364.72,
   "fin": 5368.16,
   "langue": "ar",
   "texte": "ماكائلت فايلسة ااد اي ااد مهيمة"
  },
  {
   "debut": 5368.96,
   "fin": 5370.94,
   "langue": "ar",
   "texte": "فايلسة كاسن سوشية خطي مامي"
  },
  {
   "debut": 5370.94,
   "fin": 5372.8,
   "langue": "ar",
   "texte": "وفايلو يمتشدوا ريشو"
  },
  {
   "debut": 5372.8,
   "fin": 5375.02,
   "langue": "ar",
   "texte": "هممتشدوا الصبوصي"
  },
  {
   "debut": 5375.02,
   "fin": 5377.5,
   "langue": "ar",
   "texte": "واضي او اداد وخطي قصدم معا مرو"
  },
  {
   "debut": 5378.02,
   "fin": 5380.78,
   "langue": "ar",
   "texte": "ااد ااد با اي انتا هي مركة مهيم"
  },
  {
   "debut": 5380.78,
   "fin": 5384.32,
   "langue": "ar",
   "texte": "وحانك يبقى عكسرنا كيلية ينقفوا اسمه الملو"
  },
  {
   "debut": 5385.38,
   "fin": 5389.78,
   "langue": "ar",
   "texte": "فعلا الانقاضنا دا استعمال لأيمك برغميلي يجي"
  },
  {
   "debut": 5390.36,
   "fin": 5392.62,
   "langue": "ar",
   "texte": "وإنه يكون كل شيء لها"
  },
  {
   "debut": 5392.62,
   "fin": 5395.0,
   "langue": "ar",
   "texte": "إنته ساعدو دا فيسبل جوجلتي"
  },
  {
   "debut": 5395.98,
   "fin": 5398.4,
   "langue": "ar",
   "texte": "إنته ساعدو دا دوز أكل جوجلتي"
  },
  {
   "debut": 5399.28,
   "fin": 5401.38,
   "langue": "ar",
   "texte": "إنته ساعدو دا دوز كيك كيك كيك"
  },
  {
   "debut": 5401.38,
   "fin": 5402.78,
   "langue": "ar",
   "texte": "سيكون كل شيء لبراه مش ملي"
  },
  {
   "debut": 5402.78,
   "fin": 5404.76,
   "langue": "ar",
   "texte": "تقضلاتك محلات"
  },
  {
   "debut": 5404.76,
   "fin": 5405.8,
   "langue": "ar",
   "texte": "وراوح كورنية"
  },
  {
   "debut": 5405.8,
   "fin": 5409.34,
   "langue": "ar",
   "texte": "سوته ساعدو دا مستيلة تنساعدو"
  },
  {
   "debut": 5439.34,
   "fin": 5442.18,
   "langue": "ar",
   "texte": "و أمر جوتي بوكسو صورة بوكسو صورة بيهدى"
  },
  {
   "debut": 5442.18,
   "fin": 5444.1,
   "langue": "ar",
   "texte": "موشاة ليو بيو بيو بيو بيو"
  },
  {
   "debut": 5444.1,
   "fin": 5446.32,
   "langue": "ar",
   "texte": "فطلت أزواء فرصة بقاية ليو بيو"
  },
  {
   "debut": 5446.32,
   "fin": 5448.22,
   "langue": "ar",
   "texte": "هل سؤال ما تنكيكو بيو بيو"
  },
  {
   "debut": 5448.22,
   "fin": 5449.66,
   "langue": "ar",
   "texte": "يوم السيودي"
  },
  {
   "debut": 5450.56,
   "fin": 5452.64,
   "langue": "ar",
   "texte": "عايات العتري مصوخة"
  },
  {
   "debut": 5453.34,
   "fin": 5455.2,
   "langue": "ar",
   "texte": "يمسى عايات بوشوة برجحة"
  },
  {
   "debut": 5455.2,
   "fin": 5457.08,
   "langue": "ar",
   "texte": "مكنات درسل ليه النهارة"
  },
  {
   "debut": 5457.08,
   "fin": 5457.94,
   "langue": "ar",
   "texte": "ترجحات بشاة"
  },
  {
   "debut": 5459.02,
   "fin": 5460.14,
   "langue": "ar",
   "texte": "بطاكو بشاة برجحة بسيودي"
  },
  {
   "debut": 5461.68,
   "fin": 5463.64,
   "langue": "ar",
   "texte": "ترجحات بوشوة برجحة"
  },
  {
   "debut": 5466.98,
   "fin": 5468.5,
   "langue": "ar",
   "texte": "يمسى هايات"
  },
  {
   "debut": 5472.54,
   "fin": 5473.26,
   "langue": "ar",
   "texte": "ها"
  },
  {
   "debut": 5485.2,
   "fin": 5486.24,
   "langue": "ar",
   "texte": "صواخر نعش"
  },
  {
   "debut": 5549.14,
   "fin": 5554.78,
   "langue": "ar",
   "texte": "لن تدوماس دوني ذي الشيخين أو كالميسان"
  },
  {
   "debut": 5554.78,
   "fin": 5561.04,
   "langue": "ar",
   "texte": "ونطلق قرآنه و لم تفشلنا هذا across the board"
  },
  {
   "debut": 5561.04,
   "fin": 5562.92,
   "langue": "ar",
   "texte": "فنضع دوني كه義ها امام دوني"
  },
  {
   "debut": 5562.92,
   "fin": 5564.64,
   "langue": "ar",
   "texte": "اذن نحنا소 هل اذا ماذا ترونه؟"
  },
  {
   "debut": 5564.64,
   "fin": 5566.44,
   "langue": "ar",
   "texte": "نقائد عبادة لتربيضه"
  },
  {
   "debut": 5566.72,
   "fin": 5569.1,
   "langue": "ar",
   "texte": "فجهة الآن سوف نترون هذه اللة"
  },
  {
   "debut": 5569.1,
   "fin": 5573.2,
   "langue": "ar",
   "texte": "تخفضنا صباحاً في الماء"
  },
  {
   "debut": 5716.18,
   "fin": 5719.3,
   "langue": "ar",
   "texte": "وحوية شديدك أيوه صمر"
  },
  {
   "debut": 5719.3,
   "fin": 5723.36,
   "langue": "ar",
   "texte": "وحوية أمه قاعدك أيوه"
  },
  {
   "debut": 5725.54,
   "fin": 5728.96,
   "langue": "ar",
   "texte": "وحوية شديدك وحوية فلوضة وصمر"
  },
  {
   "debut": 5728.96,
   "fin": 5732.76,
   "langue": "ar",
   "texte": "وأنعم لها وحوية عبدك"
  },
  {
   "debut": 5734.7,
   "fin": 5737.0,
   "langue": "ar",
   "texte": "وخفاتك وخفعة"
  },
  {
   "debut": 5737.6,
   "fin": 5738.78,
   "langue": "ar",
   "texte": "وشديدك في عالم"
  },
  {
   "debut": 5739.6,
   "fin": 5740.96,
   "langue": "ar",
   "texte": "وإنه عمك إلا هادك"
  },
  {
   "debut": 5741.7,
   "fin": 5743.4,
   "langue": "ar",
   "texte": "تركر ملاهدين"
  },
  {
   "debut": 5743.4,
   "fin": 5745.86,
   "langue": "ar",
   "texte": "نعم الى 3 ملاعب"
  },
  {
   "debut": 5745.86,
   "fin": 5747.06,
   "langue": "ar",
   "texte": "سيدة هي مشاكلة"
  },
