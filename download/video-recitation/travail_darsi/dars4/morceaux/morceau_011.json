 ],
 "segments": [
  {
   "debut": 5282.58,
   "fin": 5288.16,
   "langue": "ar",
   "texte": "لنزل القرآن المكي والمدني الأسواق ونعود ممهد العلين."
  },
  {
   "debut": 5291.36,
   "fin": 5299.92,
   "langue": "ar",
   "texte": "المدني الأسواق الخارج المصرية بالمدني الناس."
  },
  {
   "debut": 5300.72,
   "fin": 5304.0,
   "langue": "ar",
   "texte": "المدني التشريع الإسلامي ونعود جديد."
  },
  {
   "debut": 5304.0,
   "fin": 5305.52,
   "langue": "ar",
   "texte": "وعلى الزاق و الزاق اللي و خيرا"
  },
  {
   "debut": 5306.56,
   "fin": 5308.84,
   "langue": "ar",
   "texte": "صلاة الوحيدو مهدنا قيمنا المعاصل"
  },
  {
   "debut": 5308.84,
   "fin": 5310.88,
   "langue": "ar",
   "texte": "صدق كرم للدعوة التلمية"
  },
  {
   "debut": 5310.88,
   "fin": 5314.48,
   "langue": "ar",
   "texte": "أو نهو جايم اليو شيخ خالي"
  },
  {
   "debut": 5315.1,
   "fin": 5317.48,
   "langue": "ar",
   "texte": "وحلنا ها يديكنا اللا يدكا و المريو"
  },
  {
   "debut": 5317.48,
   "fin": 5319.5,
   "langue": "ar",
   "texte": "دي ذاك يا خيكا"
  },
  {
   "debut": 5320.62,
   "fin": 5322.6,
   "langue": "ar",
   "texte": "فصد قالي ويهي"
  },
  {
   "debut": 5323.28,
   "fin": 5326.7,
   "langue": "ar",
   "texte": "مرحبا شيخ واركي اللي ويهي بدون حضرك اللي واتي مامي"
  },
  {
   "debut": 5326.7,
   "fin": 5329.94,
   "langue": "ar",
   "texte": "أرضي دي شعيل اليو شيخ وخوحي دناته"
  },
  {
   "debut": 5330.7,
   "fin": 5332.14,
   "langue": "ar",
   "texte": "دروسدي سائن"
  },
  {
   "debut": 5332.14,
   "fin": 5333.28,
   "langue": "ar",
   "texte": "برطان"
  },
  {
   "debut": 5333.92,
   "fin": 5336.04,
   "langue": "ar",
   "texte": "هذا وإلهي وحبه من نوف الدي"
  },
  {
   "debut": 5338.0,
   "fin": 5339.82,
   "langue": "ar",
   "texte": "تلقى رامك الشيخ قناتك"
  },
  {
   "debut": 5339.82,
   "fin": 5342.02,
   "langue": "ar",
   "texte": "فاكل حلوليسان"
  },
  {
   "debut": 5342.02,
   "fin": 5344.96,
   "langue": "ar",
   "texte": "ركبضل ودعاك المتوقع واضحة"
  },
  {
   "debut": 5344.96,
