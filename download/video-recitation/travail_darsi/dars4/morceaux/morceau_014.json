   "texte": "أربع العضاء الصد السنو هي"
  },
  {
   "debut": 6867.33,
   "fin": 6868.39,
   "langue": "ar",
   "texte": "مركا"
  },
  {
   "debut": 6868.39,
   "fin": 6870.43,
   "langue": "ar",
   "texte": "افضل من شاخ"
  },
  {
   "debut": 6870.43,
   "fin": 6872.03,
   "langue": "ar",
   "texte": "وخضب صداقبان"
  },
  {
   "debut": 6872.73,
   "fin": 6873.97,
   "langue": "ar",
   "texte": "التي يبينها"
  },
  {
   "debut": 6873.97,
   "fin": 6874.27,
   "langue": "ar",
   "texte": "و كذا"
  },
  {
   "debut": 6877.72,
   "fin": 6879.73,
   "langue": "ar",
   "texte": "طبقا اوحف ربدا"
  },
  {
   "debut": 6879.73,
   "fin": 6883.23,
   "langue": "ar",
   "texte": "لكنه يقول الرئيسي بوتي كوبية."
  },
  {
   "debut": 6885.17,
   "fin": 6888.63,
   "langue": "ar",
   "texte": "مران شعوبة والمساجسة والهيبان كتكنجل."
  },
  {
   "debut": 6891.21,
   "fin": 6894.45,
   "langue": "ar",
   "texte": "مقالفات بدل البدن وليه هين روتي وحبانك يجاية."
  },
  {
   "debut": 6894.49,
   "fin": 6895.23,
   "langue": "ar",
   "texte": "يجاية كده يستي."
  },
  {
   "debut": 6895.31,
   "fin": 6896.15,
   "langue": "ar",
   "texte": "مقالفات النقط."
  },
  {
   "debut": 6897.47,
   "fin": 6900.89,
   "langue": "ar",
   "texte": "قاسة كان المعاملات المالية المعاصرة."
  },
  {
   "debut": 6901.61,
   "fin": 6905.45,
   "langue": "ar",
   "texte": "فتابكها سيارة فيقه جاهب والماركة جاهب."
  },
  {
   "debut": 6907.24,
   "fin": 6908.86,
   "langue": "ar",
   "texte": "وحن نوروتي على الهوات."
  },
  {
   "debut": 6910.67,
   "fin": 6911.85,
   "langue": "ar",
   "texte": "فصحهم بجصة بجل."
  },
  {
   "debut": 6941.85,
   "fin": 6943.93,
   "langue": "ar",
   "texte": "وكذلك يتقاعد الله ينفر بداً"
  },
  {
   "debut": 6944.91,
   "fin": 6946.31,
   "langue": "ar",
   "texte": "لن تساعدك وقاعدته"
  },
  {
   "debut": 6946.31,
   "fin": 6949.37,
   "langue": "ar",
   "texte": "ذو قفك كباستي يا ليسو"
  },
  {
   "debut": 6950.51,
   "fin": 6955.31,
   "langue": "ar",
   "texte": "وزذالك ينيدي والقدي ويساعدة يا ليا"
  },
  {
   "debut": 6955.31,
   "fin": 6956.85,
   "langue": "ar",
   "texte": "اذي يا دوفعاتي"
  },
  {
   "debut": 6957.93,
   "fin": 6960.71,
   "langue": "ar",
   "texte": "احنا كدره لليا ردك كلها الله يا ركلي"
  },
  {
   "debut": 6963.72,
   "fin": 6966.16,
   "langue": "ar",
   "texte": "وحلش كلها في الوصفة وشاقي"
  },
  {
   "debut": 6967.6,
   "fin": 6969.5,
   "langue": "ar",
   "texte": "حذر رد على وليسوك السروشي"
  },
  {
   "debut": 6970.48,
   "fin": 6974.02,
   "langue": "ar",
   "texte": "وكجهة ليا قيمة تزير عندها للحديث"
  },
  {
   "debut": 6974.86,
   "fin": 6975.34,
   "langue": "ar",
   "texte": "وعنها في اختي"
  },
  {
   "debut": 6980.26,
   "fin": 6983.78,
   "langue": "ar",
   "texte": "شيفتي دي برمان لوزار فكراكر من وكساو كولي شيخ"
  },
  {
   "debut": 6984.6,
   "fin": 6988.16,
   "langue": "ar",
   "texte": "بلا وحفظ في عنا الله هى حلقات الله خينا هى فرابا دل"
  },
  {
   "debut": 6988.16,
   "fin": 6990.56,
   "langue": "ar",
   "texte": "ان تنسيق الوصب ايه"
  },
  {
   "debut": 6991.32,
   "fin": 6995.6,
   "langue": "ar",
   "texte": "القى في قبال الله يبلا بي الكحديس بلا يبلا بي الكال وغدي واجسعتها"
  },
  {
   "debut": 6996.32,
   "fin": 6997.7,
   "langue": "ar",
   "texte": "قفكينوا بهاية هى"
  },
  {
   "debut": 6997.7,
   "fin": 6998.92,
   "langue": "ar",
   "texte": "تنسيقنا مجروم"
  },
  {
   "debut": 6999.72,
   "fin": 7001.44,
   "langue": "ar",
   "texte": "وفوضة علمية مركز دي نعكاك"
  },
  {
   "debut": 7002.8,
   "fin": 7003.92,
   "langue": "ar",
   "texte": "لكنها الجناء"
  },
  {
   "debut": 7004.86,
   "fin": 7006.68,
   "langue": "ar",
   "texte": "دوى ووخيه فرضا وي"
  },
  {
   "debut": 7006.68,
   "fin": 7009.58,
   "langue": "ar",
   "texte": "شيخو كلمدان اللي لون بيوير"
  },
  {
   "debut": 7009.58,
   "fin": 7012.78,
   "langue": "ar",
   "texte": "و هيدي ديكو اس تنسيقية"
  },
  {
   "debut": 7012.78,
   "fin": 7018.01,
   "langue": "ar",
   "texte": "و المذو"
  },
  {
   "debut": 7018.01,
   "fin": 7019.87,
   "langue": "ar",
   "texte": "ينهي و حرده بيدولس هاي"
  },
  {
   "debut": 7019.87,
   "fin": 7023.33,
   "langue": "ar",
   "texte": "طال العلم يصغو هايس التنسيقية"
  },
  {
   "debut": 7023.33,
   "fin": 7024.99,
   "langue": "ar",
   "texte": "يصغو يتشدو الحسامة يستو"
  },
  {
   "debut": 7024.99,
   "fin": 7027.77,
   "langue": "ar",
   "texte": "تلكيس عام مولو"
  },
  {
   "debut": 7028.71,
   "fin": 7030.35,
   "langue": "ar",
   "texte": "تاسعو قوم هيفسن"
  },
  {
   "debut": 7030.35,
   "fin": 7033.51,
   "langue": "ar",
   "texte": "و أطاق صحوص السيما حذره"
  },
  {
   "debut": 7033.51,
   "fin": 7035.37,
   "langue": "ar",
   "texte": "و ريش بكسرو كهر و يلي"
  },
  {
   "debut": 7035.37,
   "fin": 7037.99,
   "langue": "ar",
   "texte": "عنو يتسرر ريها"
  },
  {
   "debut": 7037.99,
   "fin": 7043.07,
   "langue": "ar",
   "texte": "و أرد خصونا قد و أخو شالو و شالس دن مموضين"
  },
  {
   "debut": 7043.75,
   "fin": 7044.87,
   "langue": "ar",
   "texte": "حواقو قرم السوء"
  },
  {
   "debut": 7044.87,
   "fin": 7045.91,
   "langue": "ar",
   "texte": "حواقو كرن"
  },
  {
   "debut": 7046.79,
   "fin": 7048.57,
   "langue": "ar",
   "texte": "ميت كللو و قادر"
  },
  {
   "debut": 7050.33,
   "fin": 7052.67,
   "langue": "ar",
   "texte": "تدعو يدر كه غرسية"
  },
  {
   "debut": 7054.01,
   "fin": 7056.69,
   "langue": "ar",
   "texte": "و قو ين انها لدت حباش كو قد بينا يو قو عالية"
  },
  {
   "debut": 7056.69,
   "fin": 7058.01,
   "langue": "ar",
   "texte": "و من غريس قو عالية"
  },
  {
   "debut": 7058.01,
   "fin": 7062.81,
   "langue": "ar",
   "texte": "و بدن لن كريسك و بدن يدبح كتب"
  },
  {
   "debut": 7062.81,
   "fin": 7063.95,
   "langue": "ar",
   "texte": "اكتيني شوط"
  },
  {
   "debut": 7065.13,
   "fin": 7066.63,
   "langue": "ar",
   "texte": "انه و يلو قد بيو"
  },
  {
   "debut": 7108.25,
   "fin": 7111.71,
   "langue": "ar",
   "texte": "بأن أضع الكفر لدوق وصفيرك أن يصل إلى جردات"
  },
  {
   "debut": 7111.71,
   "fin": 7114.55,
   "langue": "ar",
   "texte": "فأولي، وأدم في عملها أقوى قضة السرعة في أقوى ذكية"
  },
  {
   "debut": 7114.55,
   "fin": 7117.57,
   "langue": "ar",
   "texte": "أعرف الشيخ ويه"
  },
  {
   "debut": 7118.25,
   "fin": 7121.27,
   "langue": "ar",
   "texte": "ودون كبوطة متبضل أقوى في عمل سما لقارون"
  },
  {
   "debut": 7121.27,
   "fin": 7123.27,
   "langue": "ar",
   "texte": "لكن ذلك يرتبع مسوحي وحدة ده"
  },
  {
   "debut": 7123.27,
   "fin": 7126.69,
   "langue": "ar",
   "texte": "بأن التأريخ كان صحويلي ويه"
  },
  {
   "debut": 7127.53,
   "fin": 7129.37,
   "langue": "ar",
   "texte": "ويشاركي سروة في تبوك الثلاثانه"
  },
  {
   "debut": 7130.43,
   "fin": 7133.65,
   "langue": "ar",
   "texte": "ونشيخ ويه والدك المداء بقارك الله في الكفر"
  },
  {
   "debut": 7172.29,
   "fin": 7174.29,
   "langue": "ar",
   "texte": "هل قوفي عنوال كموية؟"
  },
  {
   "debut": 7175.55,
   "fin": 7175.77,
   "langue": "ar",
   "texte": "نعم"
  },
  {
   "debut": 7175.77,
   "fin": 7177.23,
   "langue": "ar",
   "texte": "نجيه وحيوى القفة دي سنة"
  },
  {
   "debut": 7177.23,
   "fin": 7178.97,
   "langue": "ar",
   "texte": "صغق عضوات بانت"
  },
  {
   "debut": 7178.97,
   "fin": 7181.11,
   "langue": "ar",
   "texte": "بس كفر ده ده"
  },
  {
   "debut": 7181.11,
   "fin": 7181.85,
   "langue": "ar",
   "texte": "نفر ده"
  },
  {
   "debut": 7189.79,
   "fin": 7191.73,
   "langue": "ar",
   "texte": "حسنا نسمي شرطين ده"
  },
  {
   "debut": 7191.73,
   "fin": 7193.33,
   "langue": "ar",
   "texte": "نعم نسمي شرطين ده ربع"
  },
  {
   "debut": 7195.01,
   "fin": 7196.41,
   "langue": "ar",
   "texte": "مالي فيه والسلية"
  },
  {
   "debut": 7196.41,
   "fin": 7197.37,
   "langue": "ar",
   "texte": "نعم نعم"
  }
 ]
}