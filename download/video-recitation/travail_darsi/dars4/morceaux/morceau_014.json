 "segments": [
  {
   "debut": 6724.02,
   "fin": 6744.59,
   "langue": "ar",
   "texte": "السلام عليكم. حسناً أخيراً مرحباً من بأسيهي تجرى ليارة أبيع المدريسييييي ينفتر كل تحسرات يوم مراحاً يتجرى ليارة عون بينهم"
  },
  {
   "debut": 6745.27,
   "fin": 6754.92,
   "langue": "ar",
   "texte": "الحالة المجرد من برفسية معلومة الحقية تلك منطبرة نقوب الخطوك ده"
  },
  {
   "debut": 6754.92,
   "fin": 6760.8,
   "langue": "ar",
   "texte": "وشيخ سيئة أو صالح علي. وشعب تغني باتقان وبركوه."
  },
  {
   "debut": 6777.4,
   "fin": 6816.77,
   "langue": "ar",
   "texte": ", عندما نابدر الثانية , حسنا انا ستر ويد"
  },
  {
   "debut": 6816.77,
   "fin": 6822.59,
   "langue": "ar",
   "texte": "انا ستر ويد"
  },
  {
   "debut": 6822.59,
   "fin": 6823.17,
   "langue": "ar",
   "texte": "حق scenery"
  },
  {
   "debut": 6829.59,
   "fin": 6830.51,
   "langue": "ar",
   "texte": "و pickup"
  },
  {
   "debut": 6830.51,
   "fin": 6833.19,
   "langue": "ar",
   "texte": "انه ايفرايا سجاشة الكهايب"
  },
  {
   "debut": 6835.74,
   "fin": 6839.32,
   "langue": "ar",
   "texte": "انه بس لسعوض ابان انا اقابب لايور"
  },
  {
   "debut": 6839.32,
   "fin": 6840.58,
   "langue": "ar",
   "texte": "بس كي بركسوت ده"
  },
  {
   "debut": 6841.62,
   "fin": 6846.42,
   "langue": "ar",
   "texte": "ايان ينقبت الولد تلغ لك ايه محذروا برجانو اتشاديية و اليماني لاول"
  },
  {
   "debut": 6847.44,
   "fin": 6851.7,
   "langue": "ar",
   "texte": "و حلول انش day قيم التزمن ايه متاي الالحليف"
  },
  {
   "debut": 6853.4,
   "fin": 6855.22,
   "langue": "ar",
   "texte": "و السجاشة الافرت يحلول Jr."
  },
  {
   "debut": 6855.32,
   "fin": 6856.32,
   "langue": "ar",
   "texte": "ايه اللوه ايه اللوه اتصه"
