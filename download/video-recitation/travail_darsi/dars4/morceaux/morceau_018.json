 "segments": [
  {
   "debut": 8670.4,
   "fin": 8673.02,
   "langue": "ar",
   "texte": "وحين اغبر انت اتوه ديه دادات"
  },
  {
   "debut": 8673.77,
   "fin": 8676.4,
   "langue": "ar",
   "texte": "بدر الجهد ايه اغبر انت"
  },
  {
   "debut": 8677.0,
   "fin": 8680.68,
   "langue": "ar",
   "texte": "ايه ان اتقبل انا تاصل كلائن وحوية"
  },
  {
   "debut": 8680.68,
   "fin": 8682.86,
   "langue": "ar",
   "texte": "ارمت حاجة ليه اواصل"
  },
  {
   "debut": 8682.86,
   "fin": 8686.64,
   "langue": "ar",
   "texte": "لكن ان اغبر اسكشت ايه سنين اهوامن وبلارنو"
  },
  {
   "debut": 8686.64,
   "fin": 8689.84,
   "langue": "ar",
   "texte": "اما كوزار ده تعلمت ايه كبوت من الوشقيني"
  },
  {
   "debut": 8689.84,
   "fin": 8693.3,
   "langue": "ar",
   "texte": "كو بيسدن سندن با الوشقيني"
  },
  {
   "debut": 8693.3,
   "fin": 8695.98,
   "langue": "ar",
   "texte": "انت اعلم كفرسة"
  },
  {
   "debut": 8695.98,
   "fin": 8700.28,
   "langue": "ar",
   "texte": "وحتى التى إبدا ده واختيضه شعار إسه كباهه رميه"
  },
  {
   "debut": 8700.28,
   "fin": 8703.66,
   "langue": "ar",
   "texte": "لابده جريبا سكول كم تجيه"
  },
  {
   "debut": 8703.66,
   "fin": 8705.44,
   "langue": "ar",
   "texte": "كي رنام تجيه جمتا ده"
  },
  {
   "debut": 8705.44,
   "fin": 8709.2,
   "langue": "ar",
   "texte": "وحتى إبدا ده يسيه إن النمغرب كاف"
  },
  {
   "debut": 8709.2,
   "fin": 8712.12,
   "langue": "ar",
   "texte": "عثر فنين سكول في كتو كده النمغرب"
  },
  {
   "debut": 8712.12,
   "fin": 8716.02,
   "langue": "ar",
   "texte": "فنوكل كل إحدى وكسوه تكده عمو سكول كبيه بوبه"
  },
  {
   "debut": 8716.02,
   "fin": 8718.82,
   "langue": "ar",
   "texte": "حتى نمحاتر تبقى نقريه"
  },
  {
   "debut": 8718.82,
   "fin": 8720.3,
   "langue": "ar",
   "texte": "اشاي جده الجدروس تكده"
  },
  {
   "debut": 8721.1,
   "fin": 8723.16,
   "langue": "ar",
   "texte": "وابعند الفترية بعض الأشاي"
  },
  {
   "debut": 8723.16,
   "fin": 8724.34,
   "langue": "ar",
   "texte": "انتها صبا يبعاد"
  },
  {
   "debut": 8724.34,
   "fin": 8729.04,
   "langue": "ar",
   "texte": "فبالأسر ما هاليلين فعلى المغرب ما هاليلين وخسك لنا ما نهي انت"
  },
  {
   "debut": 8729.62,
   "fin": 8734.64,
   "langue": "ar",
   "texte": "حبا على السمر كنك تقاص بحلك اطبحه انتن حافظك قلول القراءة بينا"
  },
  {
   "debut": 8734.64,
   "fin": 8740.38,
   "langue": "ar",
   "texte": "سروك كنك شن يو سدودي برك وينا تجوك تجي انتسن وين كنك اعلاقيه"
  },
  {
   "debut": 8740.38,
   "fin": 8747.26,
   "langue": "ar",
   "texte": "مغرب كنك ده حبا لكن بحيثها الاستكانتي الاستمرارية الاستمرارية"
  },
  {
   "debut": 8747.26,
   "fin": 8751.76,
   "langue": "ar",
   "texte": "هدي اتلاه وقضب اللهم انت وده لنا دوح الفراكة قاده"
  },
  {
   "debut": 8752.62,
   "fin": 8755.7,
   "langue": "ar",
   "texte": "بل يمكن المكالصانيين كلموا رومه هيصو"
  },
  {
   "debut": 8755.7,
   "fin": 8759.92,
   "langue": "ar",
   "texte": "فحيد مقصي انك سبق اندالي ان اخطيقائي الاريو"
  },
  {
   "debut": 8759.92,
   "fin": 8762.62,
   "langue": "ar",
   "texte": "كتاب كاندي قيو"
  },
  {
   "debut": 8762.62,
   "fin": 8764.6,
   "langue": "ar",
   "texte": "ايان بي ريض على الفترية التاز"
  },
  {
   "debut": 8764.6,
   "fin": 8765.46,
   "langue": "ar",
   "texte": "انا بارتش"
  },
  {
   "debut": 8765.46,
   "fin": 8767.46,
   "langue": "ar",
   "texte": "انا احضر كسوة كودين مغرب"
  },
  {
   "debut": 8767.46,
   "fin": 8770.74,
   "langue": "ar",
   "texte": "انت وغيب ان شايت سابكين وفريساني"
  },
  {
   "debut": 8770.74,
   "fin": 8772.22,
   "langue": "ar",
   "texte": "لابد يجلننا عن مقناة"
  },
  {
   "debut": 8772.74,
   "fin": 8773.78,
   "langue": "ar",
   "texte": "هندو تلواتنا"
  },
  {
   "debut": 8773.78,
   "fin": 8776.46,
   "langue": "ar",
   "texte": "مركز كبحو بران الشايت سيقالك"
  },
  {
   "debut": 8776.46,
   "fin": 8777.64,
   "langue": "ar",
   "texte": "يامي انا ها كبحو"
  },
  {
   "debut": 8777.64,
   "fin": 8779.18,
   "langue": "ar",
   "texte": "احنا لا يا هاي"
  },
  {
   "debut": 8779.18,
   "fin": 8781.2,
   "langue": "ar",
   "texte": "كي صبح دي بايسوه يوضي ايان تم علي"
  },
  {
   "debut": 8811.74,
   "fin": 8815.04,
   "langue": "ar",
   "texte": "وعشر كاتب لجيسان سيدة وخطي جسيسيسو"
  },
  {
   "debut": 8815.04,
   "fin": 8818.16,
   "langue": "ar",
   "texte": "ادي قدلها كسن تبكولتها لني وحوية"
  },
  {
   "debut": 8818.16,
   "fin": 8822.52,
   "langue": "ar",
   "texte": "ان فنونت ويبضانتها يارت فنونتي اللغة عربية بل"
  },
  {
   "debut": 8822.52,
   "fin": 8828.82,
   "langue": "ar",
   "texte": "فهم كي يوصيلة ان كتبتك فا مينة واللغة دي تاني بكامل اسكالك"
  },
  {
   "debut": 8828.82,
   "fin": 8831.16,
   "langue": "ar",
   "texte": "خاصة النحوية سرفي"
  },
  {
   "debut": 8832.36,
   "fin": 8834.06,
   "langue": "ar",
   "texte": "سمعي ايه انت بطك"
  },
  {
   "debut": 8834.06,
   "fin": 8836.5,
   "langue": "ar",
   "texte": "لكن حتى اتفوك رطوح"
  },
  {
   "debut": 8836.5,
   "fin": 8839.48,
   "langue": "ar",
   "texte": "هذا كان اتكوه اللي ساعد لحني جا اسكبائي لعال السو"
  },
  {
   "debut": 8839.48,
   "fin": 8843.64,
   "langue": "ar",
   "texte": "وحده قوليسا لحنية خبائراريسا وحده قلسة تاكيجر."
  },
  {
   "debut": 8844.38,
   "fin": 8849.04,
   "langue": "ar",
   "texte": "تبدأنا فرق جاديونيسي هل فيه سيو الصخب بلوك؟"
  },
  {
   "debut": 8849.04,
   "fin": 8851.96,
   "langue": "ar",
   "texte": "اجنا عدة ديوهوها قوليسي اتخقها دنكارتو."
  },
  {
   "debut": 8852.42,
   "fin": 8857.86,
   "langue": "ar",
   "texte": "اخرين ما هي ديويسي لكن مراجعة ايا المرقص المناضر."
  },
  {
   "debut": 8858.0,
   "fin": 8859.7,
   "langue": "ar",
   "texte": "فمن المراجعة ايسه."
  },
  {
   "debut": 8860.08,
   "fin": 8864.26,
   "langue": "ar",
   "texte": "ودرسي اللباد عامل ديويسي اضوكي هورفه همين بؤيا."
  },
  {
   "debut": 8864.6,
   "fin": 8865.34,
   "langue": "ar",
   "texte": "كيفا؟"
  },
  {
   "debut": 8865.34,
   "fin": 8866.48,
   "langue": "ar",
   "texte": "ساسنا اتخوضه."
  },
  {
   "debut": 8956.64,
   "fin": 8962.34,
   "langue": "ar",
   "texte": "ونحو الجلوه هدى مولده جارين أرثا قايت مهموك جاراوية"
  },
  {
   "debut": 8962.34,
   "fin": 8964.2,
   "langue": "ar",
   "texte": "إلهي وجرسين يقوموا بشينية"
  },
  {
   "debut": 8964.2,
   "fin": 8966.22,
   "langue": "ar",
   "texte": "تاسي يولى وموكم"
  },
  {
   "debut": 8966.22,
   "fin": 8970.42,
   "langue": "ar",
   "texte": "صلى الله عليه وسلم محمد وعلى ليساه ريوه صلى الله عليه وسلم"
  },
  {
   "debut": 8970.42,
   "fin": 8974.5,
   "langue": "ar",
   "texte": "سبحانك اللهم بحمدك أشهد الله إلا إلا إلا أنت الصفركة وطبيلك"
  },
  {
   "debut": 8976.0,
   "fin": 8980.26,
   "langue": "ar",
   "texte": "اللهم أخسنا لهم خشة لما تعور بي بيننا وبين معاسك"
  },
  {
   "debut": 8980.26,
   "fin": 8985.94,
   "langue": "ar",
   "texte": "ومن ضعتي لما تولغنا بهي جنة كمنا لقين ما تعور بي علينا مصايل الدنيا"
  },
  {
   "debut": 8985.94,
   "fin": 8992.02,
   "langue": "ar",
   "texte": "اللهم متعنا بيسمعنا ومصارنا وقواتنا وماحيتنا وجعروا الورس مننا"
  },
  {
   "debut": 8992.02,
   "fin": 8996.9,
   "langue": "ar",
   "texte": "واجعر الثبرنا على منظرنا ونصرنا على من عداننا"
  },
  {
   "debut": 8996.9,
   "fin": 9002.52,
   "langue": "ar",
   "texte": "ولا تجعل مصيبتنا في ديننا ولا تجعل ديات برهمنا ولا مبلغ علمنا"
  },
  {
   "debut": 9002.52,
   "fin": 9005.8,
   "langue": "ar",
   "texte": "صلى الله ولا تصل العلينا من الله يرحمنا"
  },
  {
   "debut": 9005.8,
   "fin": 9010.68,
   "langue": "ar",
   "texte": "صلى الله عليه وسلم وعلى سيدنا محمد وعلى ر. ص. ص. والحمد لله رب العام"
  }
 ]
}