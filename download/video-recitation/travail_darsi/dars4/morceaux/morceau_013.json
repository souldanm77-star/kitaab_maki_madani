 "segments": [
  {
   "debut": 6240.18,
   "fin": 6248.4,
   "langue": "ar",
   "texte": "ونعود لنا فرصة وحلينة عطيعينه. واتيننا وعليسلاته وصلاة مكولا للمدي السعابية من قصة باعملية أو بكر. وركي سعابي جيوب بلين مستكشفته سيئة."
  },
  {
   "debut": 6248.46,
   "fin": 6252.52,
   "langue": "ar",
   "texte": "سمالية السلونة جميلة علين عين. نعملها أمانت عينها. السماءة ديقى أن نضيع نه."
  },
  {
   "debut": 6253.04,
   "fin": 6268.8,
   "langue": "ar",
   "texte": "يفرصة غالجها ووهليس ويدين جن مكوية وأخطج عمر بنا وعوعة. ونعود لنا فرصة وعليسلاته وصلاة."
  },
  {
   "debut": 6296.22,
   "fin": 6297.62,
   "langue": "ar",
   "texte": "الشخصية"
  },
  {
   "debut": 6298.98,
   "fin": 6303.1,
   "langue": "ar",
   "texte": "الوقت يده رأى أن يشيرين اكتاب كتب تنانا خساب تلبرك اللهم بكم"
  },
  {
   "debut": 6303.1,
   "fin": 6306.9,
   "langue": "ar",
   "texte": "لأن اللي يرد العلاة سبحانوه وتعالى علمه غرفت ان الله يده كافعه"
  },
  {
   "debut": 6306.9,
   "fin": 6309.92,
   "langue": "ar",
   "texte": "شخنوح نانا تساكم الله خيرا دي دعوه امو يقل اخلي"
  },
  {
   "debut": 6309.92,
   "fin": 6313.8,
   "langue": "ar",
   "texte": "وانه يلغت بالمجتمعين اوه قال اللهم اللو يجي يجي يجي يجي يجي انا مات"
  },
  {
   "debut": 6313.8,
   "fin": 6316.08,
   "langue": "ar",
   "texte": "بريجو انا علمه امو يجي علمه كام برامة"
  },
  {
   "debut": 6316.08,
   "fin": 6317.2,
   "langue": "ar",
   "texte": "تحول الى البحس"
  },
  {
   "debut": 6317.2,
   "fin": 6319.9,
   "langue": "ar",
   "texte": "انا قمرك قونا اخنا رو ليجي يجي يجي يقال علمه قول يجي يوه"
  },
  {
   "debut": 6324.36,
   "fin": 6327.6,
   "langue": "ar",
   "texte": "الان هو الحدود بحيث الملكة"
  },
  {
   "debut": 6327.6,
   "fin": 6334.82,
   "langue": "ar",
   "texte": "انه يواجهowsب بحيث الملكة"
  },
  {
   "debut": 6335.7,
   "fin": 6336.4,
   "langue": "ar",
   "texte": "فركيه"
  },
  {
   "debut": 6336.4,
   "fin": 6338.84,
   "langue": "ar",
   "texte": "اللهم يعرفينك"
  },
  {
   "debut": 6349.04,
   "fin": 6349.76,
   "langue": "ar",
   "texte": "بيك"
  },
  {
   "debut": 6349.76,
   "fin": 6349.82,
   "langue": "ar",
   "texte": "اخبار ملكة"
  },
  {
   "debut": 6349.82,
   "fin": 6352.34,
   "langue": "ar",
   "texte": "وانا اخذنا إليه سبحانه وتعالى الله ينجده"
  },
  {
   "debut": 6352.34,
   "fin": 6354.54,
   "langue": "ar",
   "texte": "الشيخ إنساله وتعالى وحسنه ديزنه"
  },
  {
   "debut": 6354.54,
   "fin": 6355.86,
   "langue": "ar",
   "texte": "مركزي ما تفهم"
  },
  {
   "debut": 6355.86,
   "fin": 6357.14,
   "langue": "ar",
   "texte": "إن انسوش شيطنه"
  },
  {
   "debut": 6357.14,
   "fin": 6359.48,
   "langue": "ar",
   "texte": "وموتا لك إنه إنسانه ونساله وتعالى وعليه ذكره"
  },
  {
   "debut": 6359.48,
   "fin": 6361.78,
   "langue": "ar",
   "texte": "دي مجرس كينا دعا برسانه"
  },
  {
   "debut": 6361.78,
   "fin": 6363.62,
   "langue": "ar",
   "texte": "كفأ يدي ستانه"
  },
  {
   "debut": 6363.62,
   "fin": 6364.9,
   "langue": "ar",
   "texte": "المدوع يتعليه"
  },
  {
   "debut": 6364.9,
   "fin": 6366.22,
   "langue": "ar",
   "texte": "وديش يورو عورت ليه"
  },
  {
   "debut": 6366.22,
   "fin": 6368.38,
   "langue": "ar",
   "texte": "بك رخطر بو يتعليه دوه دا دي"
  },
  {
   "debut": 6368.38,
   "fin": 6369.8,
   "langue": "ar",
   "texte": "وعاله بوبه سوديه"
  },
  {
   "debut": 6369.8,
   "fin": 6371.38,
   "langue": "ar",
   "texte": "لنك وضيقه ونضيقه ديسه ارحكا جي"
  },
  {
   "debut": 6371.38,
   "fin": 6372.26,
   "langue": "ar",
   "texte": "والغط"
  },
  {
   "debut": 6372.26,
   "fin": 6375.0,
   "langue": "ar",
   "texte": "كشخوحي يوصع الى اوه ايه تظغطان"
  },
  {
   "debut": 6375.0,
   "fin": 6377.28,
   "langue": "ar",
   "texte": "تيجع ليه بارك الله فيكم مركاة"
  },
  {
   "debut": 6377.28,
   "fin": 6379.02,
   "langue": "ar",
   "texte": "إلهي سبحانه وتعالى لكان تسابقوا برقاني"
  },
  {
   "debut": 6379.02,
   "fin": 6380.04,
   "langue": "ar",
   "texte": "نقفوا بيويننا"
  },
  {
   "debut": 6380.04,
   "fin": 6381.52,
   "langue": "ar",
   "texte": "مساعد كنات يا مركاية"
  },
  {
   "debut": 6381.52,
   "fin": 6384.28,
   "langue": "ar",
   "texte": "دا ومضاق استطيع وقوفوا شخصي هم الله"
  },
  {
   "debut": 6384.28,
   "fin": 6386.18,
   "langue": "ar",
   "texte": "ومضونا واحد العكد وغورا"
  },
  {
   "debut": 6386.18,
   "fin": 6388.2,
   "langue": "ar",
   "texte": "مكاية إلهي لغوعا ودولو عباريسة"
  },
  {
   "debut": 6388.2,
   "fin": 6390.0,
   "langue": "ar",
   "texte": "دين تيسونا اللغوعا مره"
  },
  {
   "debut": 6390.0,
   "fin": 6392.22,
   "langue": "ar",
   "texte": "مركاستو ايه عيد التماتر سنوات"
  },
  {
   "debut": 6392.22,
   "fin": 6394.06,
   "langue": "ar",
   "texte": "تعالى مساعد كوا مخطوح وغورا ياية"
  },
  {
   "debut": 6394.06,
   "fin": 6396.2,
   "langue": "ar",
   "texte": "شيخ القلبي مسارك ومكعسك وملعا"
  },
  {
   "debut": 6396.58,
   "fin": 6398.46,
   "langue": "ar",
   "texte": "وموت بسوء بيليو ويهوائي وعيليا"
  },
  {
   "debut": 6398.46,
   "fin": 6400.98,
   "langue": "ar",
   "texte": "هم أمانا ومدين بيليو سيوه شخصايا"
  },
  {
   "debut": 6400.98,
   "fin": 6403.26,
   "langue": "ar",
   "texte": "سيدي دمكاتا يلوكس ورسينا وواتب"
  },
  {
   "debut": 6403.26,
   "fin": 6404.54,
   "langue": "ar",
   "texte": "اللي قولي يايب فارق الله فيكم"
  },
  {
   "debut": 6404.86,
   "fin": 6407.06,
   "langue": "ar",
   "texte": "زاتب السلام عليكم ورحمة الله وبركاته"
  },
  {
   "debut": 6407.62,
   "fin": 6408.5,
   "langue": "ar",
   "texte": "بسوء دوه"
  },
  {
   "debut": 6418.9,
   "fin": 6419.84,
   "langue": "ar",
   "texte": "أرد الهوية"
  },
  {
   "debut": 6420.44,
   "fin": 6421.7,
   "langue": "ar",
   "texte": "وشيخ عيليا وعطليا"
  },
  {
   "debut": 6421.7,
   "fin": 6423.42,
   "langue": "ar",
   "texte": "دي تأيه سوه شيخ"
  },
  {
   "debut": 6423.42,
   "fin": 6424.4,
   "langue": "ar",
   "texte": "وعطليا وعطليا"
  },
  {
   "debut": 6424.4,
   "fin": 6425.52,
   "langue": "ar",
   "texte": "فارق الله في كل مكلم"
  },
  {
   "debut": 6425.52,
   "fin": 6427.58,
   "langue": "ar",
   "texte": "كي يجي بيليو سيجاه"
  },
  {
   "debut": 6427.58,
   "fin": 6428.66,
   "langue": "ar",
   "texte": "دي علي العضو"
  },
  {
   "debut": 6510.2,
   "fin": 6516.46,
   "langue": "ar",
   "texte": "وعندما يخلاص وكتداران العلم للدرب في كيسة وعلى مدى قدرين توضع اي اخكرامك"
  },
  {
   "debut": 6517.16,
   "fin": 6521.6,
   "langue": "ar",
   "texte": "يدار فرضان هناك مهيان معنحة سوصانية شاقور ورنتري"
  },
  {
   "debut": 6522.02,
   "fin": 6527.1,
   "langue": "ar",
   "texte": "اتفاق نكا ديارة دولة ينكا عمرت اتكالبا لكي مجلداتك"
  },
  {
   "debut": 6527.1,
   "fin": 6530.24,
   "langue": "ar",
   "texte": "واتكا استوى وقتكيسة من قلاليه ومصوصا عاري"
  },
  {
   "debut": 6531.06,
   "fin": 6533.28,
   "langue": "ar",
   "texte": "وقتكيسة وكشة قلاليه ومصوصا عاري"
  },
  {
   "debut": 6533.9,
   "fin": 6538.48,
   "langue": "ar",
   "texte": "مركا تريشة محمل من البيسة في كيسة وطوليه وشمشوري"
  },
  {
   "debut": 6538.48,
   "fin": 6540.06,
   "langue": "ar",
   "texte": "انو ورغس انو تتخناي"
  },
  {
   "debut": 6540.06,
   "fin": 6542.24,
   "langue": "ar",
   "texte": "واتش هالو انو تتخناي"
  },
  {
   "debut": 6542.24,
   "fin": 6544.76,
   "langue": "ar",
   "texte": "واتش هالي انو انو رحطة تبانو"
  },
  {
   "debut": 6544.76,
   "fin": 6545.96,
   "langue": "ar",
   "texte": "اسمك سوطارنك"
  },
  {
   "debut": 6546.48,
   "fin": 6549.46,
   "langue": "ar",
   "texte": "انو انشاء الله سفت يعانو انوزر دو بيشان"
  },
  {
   "debut": 6549.46,
   "fin": 6553.94,
   "langue": "ar",
   "texte": "شفين انو كترينو ووضعين لأسولمان لان يديغان كسوانا"
  },
  {
   "debut": 6554.3,
   "fin": 6556.48,
   "langue": "ar",
   "texte": "يسوانا يوران بشفين انو وينينا"
  },
  {
   "debut": 6556.48,
   "fin": 6558.38,
   "langue": "ar",
   "texte": "واري لنوضب اهنجا"
  },
  {
   "debut": 6558.38,
   "fin": 6560.54,
   "langue": "ar",
   "texte": "شف سوانا يدو عالي بيشان"
  },
  {
   "debut": 6560.54,
   "fin": 6562.82,
   "langue": "ar",
   "texte": "يباسي امع المبنان بيوتو بيعان"
  },
  {
   "debut": 6562.82,
   "fin": 6569.36,
   "langue": "ar",
   "texte": "مرغشة مرونة هانتي كتبية يصورات عالصولة يتاليف فيها"
  },
  {
   "debut": 6569.36,
   "fin": 6572.74,
   "langue": "ar",
   "texte": "أمر أشن يلاعات سنة الجميل"
  },
  {
   "debut": 6572.74,
   "fin": 6577.18,
   "langue": "ar",
   "texte": "وليا لين هم مارك ريشاك وحيات بحن حتى انسور رحيز ريان طبعا"
  },
  {
   "debut": 6577.18,
   "fin": 6580.64,
   "langue": "ar",
   "texte": "شخصي بيالصورة ريشي بيارك سرق يوري"
  },
  {
   "debut": 6580.64,
   "fin": 6582.38,
   "langue": "ar",
   "texte": "ونلو لكو كوريطوانك"
  },
  {
   "debut": 6582.38,
   "fin": 6584.96,
   "langue": "ar",
   "texte": "مرغشة تاليف فيها"
  },
  {
   "debut": 6584.96,
   "fin": 6587.64,
   "langue": "ar",
   "texte": "يولك عصورة صارات يباني رالا"
  },
  {
   "debut": 6707.64,
   "fin": 6707.92,
   "langue": "ar",
   "texte": "Thank you very much."
  }
 ]
