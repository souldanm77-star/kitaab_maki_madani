 "segments": [
  {
   "debut": 6240.18,
   "fin": 6245.7,
   "langue": "ar",
   "texte": "فرصة وحلنا عطيعنا واتنّه وعليسلاته وصلاة مكوناه للمديه صحابيه هم ينقصه بعمله ومريه وبكره"
  },
  {
   "debut": 6245.7,
   "fin": 6248.04,
   "langue": "ar",
   "texte": "مركيه صحابيه جيوب بلّ ينم استكشده سيّ"
  },
  {
   "debut": 6248.04,
   "fin": 6250.12,
   "langue": "ar",
   "texte": "سمّ اللّه تسألونه يوميّ دن عاليّن عين"
  },
  {
   "debut": 6250.12,
   "fin": 6252.58,
   "langue": "ar",
   "texte": "معماله أمانت عين ههي صناه هدّي أعين نضيعنه"
  },
  {
   "debut": 6253.1,
   "fin": 6256.02,
   "langue": "ar",
   "texte": "يفرصة غالجا ووهليه سبيدين جن مكوّيه"
  },
  {
   "debut": 6256.02,
   "fin": 6257.16,
   "langue": "ar",
   "texte": "وأخطيه عمره بنا وعواه"
  },
  {
   "debut": 6257.16,
   "fin": 6259.18,
   "langue": "ar",
   "texte": "وعليسلاته وصلاة مكوّيه"
  },
  {
   "debut": 6259.18,
   "fin": 6265.14,
   "langue": "ar",
   "texte": "وعندما يقفوا هلك يوجد كمسولة أفربها لو يديني يا سؤالات أفرتها اللبع عمرك كتعلقني"
  },
  {
   "debut": 6265.14,
   "fin": 6269.16,
   "langue": "ar",
   "texte": "شاوابي لماذا محاكا لما يستي؟ عمرك يجينا محاكا لما يستي استي تعمل كويه"
  },
  {
   "debut": 6269.16,
   "fin": 6276.52,
   "langue": "ar",
   "texte": "فيس بوكو بان دا واني يييو بالكي فلا يكوش يرييو وختي هذا وحي انك اتعروا بسي دنيا رضك وليبا خاصتا"
  },
  {
   "debut": 6276.52,
   "fin": 6281.54,
   "langue": "ar",
   "texte": "وركا وختي كيك اتواكا بوربة سوبي لسا توقفوا كويه وختي راقوا فهم يلو قلبيتنا"
  },
  {
   "debut": 6311.92,
   "fin": 6313.82,
   "langue": "ar",
   "texte": "وقال لنا اللو يجيب حيننا مات"
  },
  {
   "debut": 6313.82,
   "fin": 6315.94,
   "langue": "ar",
   "texte": "وقال لنا حلو يلمو مكي علمك برام"
  },
  {
   "debut": 6315.94,
   "fin": 6317.26,
   "langue": "ar",
   "texte": "يحولا للمحيس"
  },
  {
   "debut": 6317.26,
   "fin": 6319.4,
   "langue": "ar",
   "texte": "أنا كملكي قرار كمان وقال لي جيب وقال لنا اللو يقول لك يا يو"
  },
  {
   "debut": 6319.98,
   "fin": 6321.36,
   "langue": "ar",
   "texte": "مرحان سنية تبراه ربنا"
  },
  {
   "debut": 6321.36,
   "fin": 6323.76,
   "langue": "ar",
   "texte": "وقال لي اللو يالنجيب حيس"
  },
  {
   "debut": 6323.76,
   "fin": 6324.92,
   "langue": "ar",
   "texte": "علمك جا شوخ يبنوض"
  },
  {
   "debut": 6325.54,
   "fin": 6327.74,
   "langue": "ar",
   "texte": "هيلة ينتبوتي مولانا كنجسينه"
  },
  {
   "debut": 6327.74,
   "fin": 6329.68,
   "langue": "ar",
   "texte": "ومنو قال مكي حيننا وضع رق الله فيك"
  },
  {
   "debut": 6330.14,
   "fin": 6332.38,
   "langue": "ar",
   "texte": "كمحن شخك ليك كوكر دارك أنا وعوي"
  },
  {
   "debut": 6392.38,
   "fin": 6398.82,
   "langue": "ar",
   "texte": "ومساعدك ومخطوح ومفرن يايه شيخ وكل في مساعدك ومكة عسفهم الله وموت بسوء بيغوية وإلوه يايه"
  },
  {
   "debut": 6398.82,
   "fin": 6401.36,
   "langue": "ar",
   "texte": "هم أمانا ومدين بيغوية ومشاق يايه"
  },
  {
   "debut": 6401.36,
   "fin": 6404.54,
   "langue": "ar",
   "texte": "سيد يايه دى مكتب إيه لكسرسينا ووواتب لجولي يايه فارق الله فيكم"
  },
  {
   "debut": 6404.54,
   "fin": 6407.6,
   "langue": "ar",
   "texte": "زادب السلام عليكم ورحمة الله وبركاته"
  },
  {
   "debut": 6407.6,
   "fin": 6408.08,
   "langue": "ar",
   "texte": "بشيطا"
  },
  {
   "debut": 6408.08,
   "fin": 6421.56,
   "langue": "ar",
   "texte": "أرض الحوريه وشيخ ورحمة الله وبركاته"
  },
  {
   "debut": 6421.56,
   "fin": 6424.09,
   "langue": "ar",
   "texte": "دى أيها سوى شيخ ورحمة الله وبركاته"
  },
  {
   "debut": 6424.5,
   "fin": 6425.8,
   "langue": "ar",
   "texte": "فارق الله فيكم كلمة"
  },
  {
   "debut": 6425.8,
   "fin": 6427.36,
   "langue": "ar",
   "texte": "كي يجي بيغوية سيخ"
  },
  {
   "debut": 6563.26,
   "fin": 6572.24,
   "langue": "ar",
   "texte": "مرهشة فا مرهانتي كتبية يصوبة عالسوء يتاليف فيه ستعمل عطن سنة الجومن"
  },
  {
   "debut": 6572.24,
   "fin": 6577.16,
   "langue": "ar",
   "texte": "والله يالين هم مارك ترشاف وحيات بحن حتى انسور رحيزين طبعا"
  },
  {
   "debut": 6577.16,
   "fin": 6582.54,
   "langue": "ar",
   "texte": "شخصيبي عالسوء برنسي بجاربه هر جيسر جيوره برنلولي كنكولي تونكي"
  },
  {
   "debut": 6582.54,
   "fin": 6587.62,
   "langue": "ar",
   "texte": "مرهشة فا تاليف فيه ستعمل عسوء ورسعه وراني رالا"
  },
  {
   "debut": 6647.62,
   "fin": 6648.56,
   "langue": "ar",
   "texte": "كما ينقف فيه في سنو."
  },
  {
   "debut": 6648.86,
   "fin": 6651.82,
   "langue": "ar",
   "texte": "ونحن نقف فيه يالي للمناء في تكتجه."
  },
  {
   "debut": 6652.16,
   "fin": 6654.02,
   "langue": "ar",
   "texte": "تكتجه الرموض وما يقرأونه دي."
  },
  {
   "debut": 6654.52,
   "fin": 6655.62,
   "langue": "ar",
   "texte": "شرط شرط مهالو."
  },
  {
   "debut": 6655.74,
   "fin": 6656.9,
   "langue": "ar",
   "texte": "شرط وسيطانع."
  },
  {
   "debut": 6657.1,
   "fin": 6659.66,
   "langue": "ar",
   "texte": "تكتجه شرط ونقف فيه تفسير فكافل البعض المغرب."
