 "segments": [
  {
   "debut": 0.0,
   "fin": 2.92,
   "langue": "ar",
   "texte": "السلام عليكم ورحمة الله وبركاته"
  },
  {
   "debut": 4.24,
   "fin": 7.54,
   "langue": "ar",
   "texte": "صلاته وصلاة على شرف المرسلين"
  },
  {
   "debut": 7.54,
   "fin": 10.64,
   "langue": "ar",
   "texte": "سيدنا محمد وعالى لي وصحباة المعين"
  },
  {
   "debut": 11.62,
   "fin": 17.24,
   "langue": "ar",
   "texte": "اللهم فعنا بما علمتنا وعلمنا وينفعنا وزدنا علمه"
  },
  {
   "debut": 17.24,
   "fin": 20.76,
   "langue": "ar",
   "texte": "ولا تجعل فيما علمتنا وبالا علينا"
  },
  {
   "debut": 20.76,
   "fin": 27.1,
   "langue": "ar",
   "texte": "قال لي ما مسي ولي رحمه الله تعالى وردي الله عنه"
  },
  {
   "debut": 27.1,
   "fin": 35.68,
   "langue": "ar",
   "texte": "قد أثر مناصف المنصوخ من عدد واتخلوا فيه آيًا ليس تنحصروا"
  },
  {
   "debut": 35.68,
   "fin": 39.5,
   "langue": "ar",
   "texte": "وهك تحرير آيًا لما زيد لها"
  },
  {
   "debut": 40.1,
   "fin": 43.56,
   "langue": "ar",
   "texte": "أشترينا حرّرها لفضاق والكبر"
  },
  {
   "debut": 43.9,
   "fin": 47.98,
   "langue": "ar",
   "texte": "أي توجهي حيث المرء كان وقان"
  },
  {
   "debut": 47.98,
   "fin": 51.34,
   "langue": "ar",
   "texte": "يُصيّل أهريه عند الموت محصدروا"
  },
  {
   "debut": 52.1,
   "fin": 55.44,
   "langue": "ar",
   "texte": "قل لي مدمجي ما مسويض بايماء بلاد ميا"
  },
  {
   "debut": 117.12,
   "fin": 123.7,
   "langue": "ar",
   "texte": "ينضح الجبال العالي الذي يكلمه أشفق على الرأس لا تشفق على الجبال"
  },
  {
   "debut": 125.42,
   "fin": 132.62,
   "langue": "ar",
   "texte": "بالمركة أبي أدي من قد جرنا وحلي مامك الرحمن طلع عليه قد أسفر ويبديا"
  },
  {
   "debut": 132.62,
   "fin": 138.56,
   "langue": "ar",
   "texte": "أن ناس وعلمان يمألفين تعين أماموا فصرين هنقلين يكو اكو تقط النصق"
  },
  {
   "debut": 138.56,
   "fin": 147.76,
   "langue": "ar",
   "texte": "اللي فيبة ويجب بقبوت في المنسوخ وآياتك لنسخة القرآن كسوكا بيبديا من عددها"
  },
  {
   "debut": 148.24,
   "fin": 155.26,
   "langue": "ar",
   "texte": "دهانية ترقها وترقل بيشجع وده كتبتها نسخة مسوخة دان قادرنه لا بقل"
  },
  {
   "debut": 155.26,
   "fin": 162.24,
   "langue": "ar",
   "texte": "أيضا دو حكس الريان نركينا يسوعرورنا يان واتخلوا وحيج جريان ونسخ يكوصو"
  },
  {
   "debut": 192.24,
   "fin": 195.58,
   "langue": "ar",
   "texte": "تحرير كده لن يزيد الله وحلوه بيريه"
  },
  {
   "debut": 195.58,
   "fin": 198.16,
   "langue": "ar",
   "texte": "والله يسيط رابعان يتشيرين"
  },
  {
   "debut": 198.16,
   "fin": 199.26,
   "langue": "ar",
   "texte": "أو كوبن"
  },
  {
   "debut": 199.26,
   "fin": 200.84,
   "langue": "ar",
   "texte": "أو القرآن كالوران كرو"
  },
  {
   "debut": 200.84,
   "fin": 202.74,
   "langue": "ar",
   "texte": "درين لأنه هلينه"
  },
  {
   "debut": 202.74,
   "fin": 205.44,
   "langue": "ar",
   "texte": "آياتك لنستخين عن هلينه"
  },
  {
   "debut": 205.44,
   "fin": 207.74,
   "langue": "ar",
   "texte": "أو قران كوان منصخ لبعوران اليوم"
  },
  {
   "debut": 207.74,
   "fin": 212.28,
   "langue": "ar",
   "texte": "اشترينا تحرير آيات نظيفة راعننا وهكو حقاته"
  },
  {
   "debut": 212.28,
   "fin": 215.52,
   "langue": "ar",
   "texte": "اشترينا آيات مال لباطن آيضو"
  },
  {
   "debut": 215.52,
   "fin": 218.32,
   "langue": "ar",
   "texte": "و العوران اليوه منصخه"
  },
  {
   "debut": 218.32,
   "fin": 221.78,
   "langue": "ar",
   "texte": "حرارها ايضا بديه اي تحريريه"
  },
  {
   "debut": 251.78,
   "fin": 254.36,
   "langue": "ar",
   "texte": "ونحن نتعرف على كل ما يقوم بإمكانك"
  },
  {
   "debut": 254.36,
   "fin": 257.34,
   "langue": "ar",
   "texte": "لما بدأت بإدواء هربع"
  },
  {
   "debut": 257.34,
   "fin": 259.04,
   "langue": "ar",
   "texte": "آياتك ويونور بلا ري"
  },
  {
   "debut": 259.86,
   "fin": 261.7,
   "langue": "ar",
   "texte": "ندميها مركزاً ايجاناً"
  },
  {
   "debut": 261.7,
   "fin": 265.84,
   "langue": "ar",
   "texte": "آياتك لأورني ومنصوخ وموقصوان"
  },
  {
   "debut": 265.84,
   "fin": 268.26,
   "langue": "ar",
   "texte": "ناسخ إما خاكم صرنا"
  },
  {
   "debut": 268.26,
   "fin": 271.98,
   "langue": "ar",
   "texte": "أبيادنا ديور روح دوني ورعبيادنا صوضاً نقلنا"
  },
  {
   "debut": 271.98,
   "fin": 273.88,
   "langue": "ar",
   "texte": "إمام كاس يودي"
  },
  {
   "debut": 273.88,
   "fin": 277.48,
   "langue": "ar",
   "texte": "كتاب ديكو تقطع علم القرآن كله"
  },
  {
   "debut": 277.48,
   "fin": 279.24,
   "langue": "ar",
   "texte": "كتاب ويكوا بضانتها"
  },
  {
   "debut": 279.24,
   "fin": 285.82,
   "langue": "ar",
   "texte": "وحكم ذا كتاب كالتقامة وكتبتي وقال لي فيك ويقومت دمبيك ويقومت دمبيك كم ذا"
  },
  {
   "debut": 285.82,
   "fin": 292.32,
   "langue": "ar",
   "texte": "وانا كتاب مركز ليابع علم القرآن كتبت عليها الله دا احق السرق المضه"
  },
  {
   "debut": 292.32,
   "fin": 297.4,
   "langue": "ar",
   "texte": "طبعاتك لدوان نولها كوى سجح مجلد ايك ريان كوى اللبن"
  },
  {
   "debut": 297.4,
   "fin": 305.78,
   "langue": "ar",
   "texte": "وحتران اي مجمع اي الملك فهر وحكم الصاحبتي ومدينة دا دو طبعا لجومة دبعا اي"
  },
  {
   "debut": 396.14,
   "fin": 407.92,
   "langue": "ar",
   "texte": "اواتنا صلاة انا ملكريما اولا شيط سنة. ايضا سيحروع منصوخ اصبه وحوية وعباس يرقعون. وحكدوا انه وانش يجدون."
  },
  {
   "debut": 408.26,
   "fin": 421.0,
   "langue": "ar",
   "texte": "احنا سخيب مركاص ويله قولكي سيولي فاوليواتك الشضرا المسد الحراء. وحدوش يقاووش يديسة. صلاة داد اولا شيط ستة. حكاة مثل الحرام يبيتك."
  },
  {
   "debut": 421.0,
   "fin": 426.22,
   "langue": "ar",
   "texte": "كعبد أوليش يتصق. عيادة أسبوع. عيادة حكم كيدي النصخ ضي."
  },
  {
   "debut": 427.68,
   "fin": 433.5,
   "langue": "ar",
   "texte": "اللوحان لانه عيادة هوري. ايه فأيه نمات وللو فصمه وشوله وحي نوف ايدي نساء."
  },
  {
   "debut": 434.1,
   "fin": 438.0,
   "langue": "ar",
   "texte": "مسد الحرام يكعبض المال عنه نساء دي لو لتش يتسنكره."
  },
  {
   "debut": 438.52,
   "fin": 443.24,
   "langue": "ar",
   "texte": "عيادة انك لانه محيف ايدي نساء فولي وتش كشدر المسد الحرام."
  },
  {
   "debut": 443.34,
   "fin": 445.06,
   "langue": "ar",
   "texte": "انه ني دي بل نانين."
  },
  {
   "debut": 445.78,
   "fin": 448.34,
   "langue": "ar",
   "texte": "زمس الحرام موي ملكة لو لو يتصق."
  },
  {
   "debut": 448.34,
   "fin": 452.24,
   "langue": "ar",
   "texte": "ورقاة المعاق من عباس كلم دي هي السلفكي."
  },
  {
   "debut": 452.6,
   "fin": 457.14,
   "langue": "ar",
   "texte": "أيها واحد كالي ينسان وندمج وصول ايضا عيادة سين منصوخ تاي."
  },
  {
   "debut": 457.7,
   "fin": 460.14,
   "langue": "ar",
   "texte": "ناسخضنا عيادة انضمتك الهبرية."
  },
  {
   "debut": 460.62,
   "fin": 462.18,
   "langue": "ar",
   "texte": "ورقاة سوى صول ايضا."
  },
  {
   "debut": 463.2,
   "fin": 466.8,
   "langue": "ar",
   "texte": "وحقلوا ايها ده هل كان لبي لعيد نصق كمتره."
  },
  {
   "debut": 467.1,
   "fin": 468.18,
   "langue": "ar",
   "texte": "ومنصوخ معها."
  },
  {
   "debut": 468.6,
   "fin": 472.08,
   "langue": "ar",
   "texte": "لكن ما هي كو حنبارة ومركن سبب في نزولك يقاقناه."
  },
  {
   "debut": 472.08,
   "fin": 475.86,
   "langue": "ar",
   "texte": "يجب أن تكون فيه جرام باقبلته"
  },
  {
   "debut": 475.86,
   "fin": 479.92,
   "langue": "ar",
   "texte": "يمكن أن يكون فيه أسقوباً ويجب أن يكون فيه جرام باقبلته"
  }
 ]
}