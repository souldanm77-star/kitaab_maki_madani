  },
  {
   "debut": 2502.54,
   "fin": 2503.52,
   "langue": "ar",
   "texte": "بلدي اوطو"
  },
  {
   "debut": 2504.14,
   "fin": 2504.18,
   "langue": "ar",
   "texte": "بلدي اوطو"
  },
  {
   "debut": 2505.82,
   "fin": 2507.28,
   "langue": "ar",
   "texte": "هادر النار"
  },
  {
   "debut": 2507.28,
   "fin": 2509.16,
   "langue": "ar",
   "texte": "لحوائي"
  },
  {
   "debut": 2511.84,
   "fin": 2512.84,
   "langue": "ar",
   "texte": "لحوائي"
  },
  {
   "debut": 2512.84,
   "fin": 2534.54,
   "langue": "ar",
   "texte": "وعندما سند الشيويسة. انه مصوخة ايه. وعندكه الرئيسة. اين اسخدوها دي نقطو حقا سفنا ايه اما دا ايه وحيالي متاعا لسي نيعم ايه ام فاقا ايه وحيالها اصنا. ايه دحلكي بيوحكو ليه. دحلكي دي بيقادن. مددها سنوى مددها ايه اده ترسن ايه صح."
  },
  {
   "debut": 2534.54,
   "fin": 2537.58,
   "langue": "ar",
   "texte": "و المركاتها صوء و أفر بلوضهم"
  },
  {
   "debut": 2537.58,
   "fin": 2539.04,
   "langue": "ar",
   "texte": "أما يطبن"
  },
  {
   "debut": 2539.04,
   "fin": 2540.14,
   "langue": "ar",
   "texte": "أما تنكلي"
  },
  {
   "debut": 2540.14,
   "fin": 2543.22,
   "langue": "ar",
   "texte": "إيشي غيسة صند و حكم منصوخ"
  },
  {
   "debut": 2543.22,
   "fin": 2546.2,
   "langue": "ar",
   "texte": "عبر التاسوية و أنا ساعت من العلمة يكوتجن"
  },
  {
   "debut": 2546.2,
   "fin": 2548.84,
   "langue": "ar",
   "texte": "أرنبا لكن نقوء ما نسه"
  },
  {
   "debut": 2548.84,
   "fin": 2551.82,
   "langue": "ar",
   "texte": "و يسيرا بعض العلمة يو كوبتجن"
  },
  {
   "debut": 2551.82,
   "fin": 2554.8,
   "langue": "ar",
   "texte": "أرن كان أفر بلوض يطبن و إن لازمة"
  },
  {
   "debut": 2554.8,
   "fin": 2557.48,
   "langue": "ar",
   "texte": "و أيكو عدت رسنة صوء"
  },
  {
   "debut": 2557.48,
   "fin": 2560.68,
   "langue": "ar",
   "texte": "لكن أنت صند يكارت صدوم بلوضي اللباتنا"
  },
  {
   "debut": 2560.68,
   "fin": 2564.0,
   "langue": "ar",
   "texte": "و حق اللي يجورجين كوبتجن"
  },
  {
   "debut": 2594.0,
   "fin": 2597.02,
   "langue": "ar",
   "texte": "وعيد الله أبقى لياء فرطنا لأسرط البقرة"
  },
  {
   "debut": 2597.02,
   "fin": 2600.1,
   "langue": "ar",
   "texte": "أعيد أفر بروديو ثبونك يبسويننا"
  },
  {
   "debut": 2600.1,
   "fin": 2602.24,
   "langue": "ar",
   "texte": "وعيد الله أبقى لياء فرطنا"
  },
  {
   "debut": 2602.24,
   "fin": 2604.4,
   "langue": "ar",
   "texte": "حاجة كتانكم حاكوه الرئية"
  },
  {
   "debut": 2604.94,
   "fin": 2607.22,
   "langue": "ar",
   "texte": "أعيدنا فرط بروديو ثبون"
  },
  {
   "debut": 2607.22,
   "fin": 2608.54,
   "langue": "ar",
   "texte": "محادا بيصا"
  },
  {
   "debut": 2608.54,
   "fin": 2610.6,
   "langue": "ar",
   "texte": "أعيدا صندادا بيصا"
  },
  {
   "debut": 2610.6,
   "fin": 2612.58,
   "langue": "ar",
   "texte": "يقول هدى الله هنا سخة منسوخه"
  },
  {
   "debut": 2612.58,
   "fin": 2615.04,
   "langue": "ar",
   "texte": "منسوخها هر رئيونها سخة دبية"
  },
  {
