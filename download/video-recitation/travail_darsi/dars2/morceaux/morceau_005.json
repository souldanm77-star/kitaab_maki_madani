 "segments": [
  {
   "debut": 2400.0,
   "fin": 2402.28,
   "langue": "ar",
   "texte": "أحوية وحاية إن الدردارما"
  },
  {
   "debut": 2402.59,
   "fin": 2406.18,
   "langue": "ar",
   "texte": "أول كده يكتل إنه يوضر دردارما صندداً"
  },
  {
   "debut": 2406.76,
   "fin": 2412.28,
   "langue": "ar",
   "texte": "أحوية دوى سنهودي متاعودي وحاية أبوى هنائياً وصند."
  },
  {
   "debut": 2412.54,
   "fin": 2415.66,
   "langue": "ar",
   "texte": "تاسخ سورة القرآن كي نغبسوان تسورة البقرة"
  },
  {
   "debut": 2416.45,
   "fin": 2419.1,
   "langue": "ar",
   "texte": "عايت كهر ريسنا وحكو بسوان"
  },
  {
   "debut": 2419.1,
   "fin": 2422.48,
   "langue": "ar",
   "texte": "والذين يتوفون منكم ويدرونها الزواجين"
  },
  {
   "debut": 2422.48,
   "fin": 2425.78,
   "langue": "ar",
   "texte": "يتربصنا بأفصينا 24 معشرة"
  },
  {
   "debut": 2425.78,
   "fin": 2427.0,
   "langue": "ar",
   "texte": "كوالي منية"
  },
  {
   "debut": 2427.45,
   "fin": 2429.42,
   "langue": "ar",
   "texte": "دمر أي قبين كبتة ليا"
  },
  {
   "debut": 2429.42,
   "fin": 2454.3,
   "langue": "ar",
   "texte": "او مركيا اي كتبين افر بلادية او بيكل عدة ترسن اي انا اي فرلي اي انا او دي مجرس اكران ينتهى دي سيسنوها او قبات مياح اعديس ان اقروح دي او اخي القروح كي ان اي بلمركاس اعلى بو حربون اي واسكائي الالنين مدده اداني دي اور لحينو اي انا ادادو دو احن نقنت اور كلاين مركيا الاشون باقاني حتى ابي ان دي باها بارداشه"
  },
  {
   "debut": 2456.02,
   "fin": 2460.58,
   "langue": "ar",
   "texte": "وضع كوضوك دوية. وضع كنسة سندن."
  },
  {
   "debut": 2461.02,
   "fin": 2465.9,
   "langue": "ar",
   "texte": "متاع قودي يو قرغي ان اسكجبت شرتي دردار انك اشتره."
  },
  {
   "debut": 2466.36,
   "fin": 2469.84,
   "langue": "ar",
   "texte": "من نوح كنسة اتدو دو افر بلاديو طبعا ان اتا."
  },
  {
   "debut": 2470.02,
   "fin": 2473.66,
   "langue": "ar",
   "texte": "لبدو دي اسمو وافتن كرنوك موضع عمل فريكرنو."
  },
  {
   "debut": 2474.08,
   "fin": 2477.94,
   "langue": "ar",
   "texte": "اركابو حوينو شاوية ايمان كن رحمه الله تعالى."
  },
  {
   "debut": 2477.94,
   "fin": 2479.56,
   "langue": "ar",
   "texte": "ايضا كينيسه"
  },
  {
   "debut": 2479.56,
   "fin": 2487.2,
   "langue": "ar",
   "texte": "دو مرقا يغا احال المتعسين ايه لوضر دار مياس صندقين يجعل ايه تا يتا حكم كاس"
  },
  {
   "debut": 2487.2,
   "fin": 2494.26,
   "langue": "ar",
   "texte": "وليبانو ايه ده هار ام مرقا اصا ايه ده ضب ايه انو منصوق يه ايه"
  },
  {
   "debut": 2494.26,
   "fin": 2498.5,
   "langue": "ar",
   "texte": "محان النسخ ايه ايه تا يتلقى بس يه ريسه او اه"
  },
  {
   "debut": 2498.5,
   "fin": 2505.82,
   "langue": "ar",
   "texte": "دو مرقا افر بلودي او طويل دو ايه طا ام قبل دا قدن مسلمين ايه قبل دا قمان اددو ايه تا ييه بلتابا ويه"
  },
  {
   "debut": 2505.82,
   "fin": 2509.6,
   "langue": "ar",
   "texte": "انتس كلينا أرن كتاب ويانو"
  },
  {
   "debut": 2509.6,
   "fin": 2512.84,
   "langue": "ar",
   "texte": "اوحوية نجمور العلماء وحكوتي"
  },
  {
   "debut": 2513.68,
   "fin": 2515.88,
   "langue": "ar",
   "texte": "آيادنا سند شيبيسة"
  },
  {
   "debut": 2515.88,
   "fin": 2517.44,
   "langue": "ar",
   "texte": "اني مصوخ طاية"
  },
  {
   "debut": 2517.44,
   "fin": 2519.5,
   "langue": "ar",
   "texte": "وآياد دا كه الرئيسة"
  },
  {
   "debut": 2519.5,
   "fin": 2521.74,
   "langue": "ar",
   "texte": "اينا سخضوها دا ينقطو حقا"
  },
  {
   "debut": 2521.74,
   "fin": 2524.04,
   "langue": "ar",
   "texte": "سفنا اي عمد ايوحي علي"
  },
  {
   "debut": 2524.04,
   "fin": 2526.08,
   "langue": "ar",
   "texte": "متاعا لسي نيعم ايوحي"
  },
  {
   "debut": 2526.08,
   "fin": 2527.82,
   "langue": "ar",
   "texte": "انفاقا ايوحي عليها اصنا"
  },
  {
   "debut": 2527.82,
   "fin": 2529.24,
   "langue": "ar",
   "texte": "ايوحي حلكي بيوحكو لي"
  },
  {
   "debut": 2529.8,
   "fin": 2531.26,
   "langue": "ar",
   "texte": "تحلكي ايدي بيقادا"
  },
  {
   "debut": 2531.72,
   "fin": 2534.54,
   "langue": "ar",
   "texte": "مددس نو مدده ايعدا ترسن ايصو"
  },
  {
   "debut": 2534.54,
   "fin": 2537.58,
   "langue": "ar",
   "texte": "و المركاتها صوء و أفر بلوضهم"
  },
  {
   "debut": 2537.58,
   "fin": 2539.04,
   "langue": "ar",
   "texte": "أما يطبن"
  },
  {
   "debut": 2539.04,
   "fin": 2540.14,
   "langue": "ar",
   "texte": "أما تنكلي"
  },
  {
   "debut": 2540.14,
   "fin": 2543.22,
   "langue": "ar",
   "texte": "إيشي غيسة صند و حكم منصوخ"
  },
  {
   "debut": 2543.22,
   "fin": 2546.2,
   "langue": "ar",
   "texte": "عبر التاسوية و أنا ساعت من العلمة يكوتجن"
  },
  {
   "debut": 2546.2,
   "fin": 2548.84,
   "langue": "ar",
   "texte": "أرنبا لكن نقوء ما نسه"
  },
  {
   "debut": 2548.84,
   "fin": 2551.82,
   "langue": "ar",
   "texte": "و يسيرا بعض العلمة يو كوبتجن"
  },
  {
   "debut": 2551.82,
   "fin": 2554.8,
   "langue": "ar",
   "texte": "أرن كان أفر بلوض يطبن و إن لازمة"
  },
  {
   "debut": 2554.8,
   "fin": 2557.48,
   "langue": "ar",
   "texte": "و أيكو عدت رسنة صوء"
  },
  {
   "debut": 2557.48,
   "fin": 2560.68,
   "langue": "ar",
   "texte": "لكن أنت صند يكارت صدوم بلوضي اللباتنا"
  },
  {
   "debut": 2560.68,
   "fin": 2564.0,
   "langue": "ar",
   "texte": "و حق اللي يجورجين كوبتجن"
  },
  {
   "debut": 2594.0,
   "fin": 2597.02,
   "langue": "ar",
   "texte": "وعيد الله أبقى لياء فرطنا لأسرط البقرة"
  },
  {
   "debut": 2597.02,
   "fin": 2600.1,
   "langue": "ar",
   "texte": "أعيد أفر بروديو ثبونك يبسويننا"
  },
  {
   "debut": 2600.1,
   "fin": 2602.24,
   "langue": "ar",
   "texte": "وعيد الله أبقى لياء فرطنا"
  },
  {
   "debut": 2602.24,
   "fin": 2604.4,
   "langue": "ar",
   "texte": "حاجة كتانكم حاكوه الرئية"
  },
  {
   "debut": 2604.94,
   "fin": 2607.22,
   "langue": "ar",
   "texte": "أعيدنا فرط بروديو ثبون"
  },
  {
   "debut": 2607.22,
   "fin": 2608.54,
   "langue": "ar",
   "texte": "محادا بيصا"
  },
  {
   "debut": 2608.54,
   "fin": 2610.6,
   "langue": "ar",
   "texte": "أعيدا صندادا بيصا"
  },
  {
   "debut": 2610.6,
   "fin": 2612.58,
   "langue": "ar",
   "texte": "يقول هدى الله هنا سخة منسوخه"
  },
  {
   "debut": 2612.58,
   "fin": 2615.04,
   "langue": "ar",
   "texte": "منسوخها هر رئيونها سخة دبية"
  },
  {
   "debut": 2615.04,
   "fin": 2616.98,
   "langue": "ar",
   "texte": "لبدا أعيدو كتابكي"
  },
  {
   "debut": 2617.5,
   "fin": 2620.22,
   "langue": "ar",
   "texte": "تين دبي سيوية تنعلانا والمنسوخ"
  },
  {
   "debut": 2710.22,
   "fin": 2726.84,
   "langue": "ar",
   "texte": "ايه بالمركة ويكون ولي اعتداده اذا ترسي بحول ان سندل ويبعد ارسده مع وصية مع وصية المرأة التي توفي عنها يدوري بلو در دارما يسفناها بشأة ايه لك سنداته ويسف متاعدي لو در دارما يو"
  },
  {
   "debut": 2726.84,
   "fin": 2734.9,
   "langue": "ar",
   "texte": "فقروا فقدروا الناس اخيرا و افر بروديا و انت احبوا انو ان افر بروديا و انت قدعين اين اقتطو"
  },
  {
   "debut": 2734.9,
   "fin": 2740.9,
   "langue": "ar",
   "texte": "و ان يداني حديث النفسي والفكره اشرق كلائه رأي اديو نا انت ادعو له"
  },
  {
   "debut": 2740.9,
   "fin": 2743.24,
   "langue": "ar",
   "texte": "لا سبحانه وتعاله علىه علىه"
  },
  {
   "debut": 2743.24,
   "fin": 2748.02,
   "langue": "ar",
   "texte": "سبحانك الله مبحمدك اشدو الله لا اله الا تصفرك و تو بيليه"
  },
  {
   "debut": 2748.02,
   "fin": 2751.72,
   "langue": "ar",
   "texte": "صلى الله عليه وسلم محمد و عالا لي وسه فيه صلى الله عليه وسلم"
  }
 ]
}