 "segments": [
  {
   "debut": 2400.0,
   "fin": 2406.0,
   "langue": "ar",
   "texte": "احوية وحاق ايتي ان الدردار ما اول كو دا يكتل ان يوضر دار ما صندلا"
  },
  {
   "debut": 2406.0,
   "fin": 2415.66,
   "langue": "ar",
   "texte": "احوية دوى سنهودي متاعودي وحاق ايببه نايا واصند تاسخ سورة القرام كي نغبس وانت سورة البقرة"
  },
  {
   "debut": 2415.66,
   "fin": 2422.46,
   "langue": "ar",
   "texte": "ايات كهر ريسنا وحكبس وان واللينا يتوفون منكم ويدرونها زواجا"
  },
  {
   "debut": 2422.46,
   "fin": 2427.0,
   "langue": "ar",
   "texte": "يتربصنا باوفصنا اربعة اشر معشرة كوالي من اية"
  },
  {
   "debut": 2427.0,
   "fin": 2454.24,
   "langue": "ar",
   "texte": "دمر اي قبين كبات ايه دمر كي اي كت ايه افر بلادي اتهم بي كل ادت ارسن ايه انا اي فرلي ايه انا او دي مجرس ايه انا اي انت ايه سنوه ايه او بات مياح اعديس انا قروح دي او ايه اخروح كي ان ايه بلمركز اعلى بحربون ايه واسكائي الالنية المدده اداني دي اور لحينو ايه انا ايه ادو دو احن اقنت اور كلاين مركز ايه لشون بي انا اقنح اتها بي ان ادو ايه بحبار داشه."
  },
  {
   "debut": 2484.24,
   "fin": 2485.06,
   "langue": "ar",
   "texte": "الا مضابق للنقر يا صندوق"
  },
  {
   "debut": 2485.06,
   "fin": 2486.16,
   "langue": "ar",
   "texte": "وهيا Reports"
  },
  {
   "debut": 2486.16,
   "fin": 2488.32,
   "langue": "ar",
   "texte": "اللدى big nama"
  },
  {
   "debut": 2488.32,
   "fin": 2491.28,
   "langue": "ar",
   "texte": "ايضى ايضى عالب"
  },
  {
   "debut": 2491.28,
   "fin": 2498.32,
   "langue": "ar",
   "texte": "ويطیو تفضل المرس او او اخ"
  },
  {
   "debut": 2499.04,
   "fin": 2500.22,
   "langue": "ar",
   "texte": "بلودي اوطو"
  },
  {
   "debut": 2500.22,
   "fin": 2501.06,
   "langue": "ar",
   "texte": "بلدي اوطو"
  },
  {
   "debut": 2501.06,
   "fin": 2501.82,
   "langue": "ar",
   "texte": "بلدي اوطو"
  },
  {
   "debut": 2501.82,
   "fin": 2502.54,
